    </changeSet>

    <!-- Migra il cliente Andrea Angeloni da desktop-user al primo utente reale registrato -->
    <changeSet id="migrate_andrea_angeloni_client" author="angeloni">
        <sql>
            UPDATE clients
            SET user_id = (SELECT id FROM users WHERE username != 'desktop-user' ORDER BY id ASC LIMIT 1)
            WHERE name = 'Andrea' AND surname = 'Angeloni'
              AND user_id = (SELECT id FROM users WHERE username = 'desktop-user')
              AND EXISTS (SELECT 1 FROM users WHERE username != 'desktop-user')
        </sql>
    </changeSet>

