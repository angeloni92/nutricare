    <!-- Fix: vincolo unique su (name, surname) era globale, deve essere per-utente -->
    <changeSet id="fix_client_unique_per_user" author="angeloni">
        <sql>ALTER TABLE clients DROP CONSTRAINT IF EXISTS unique_name_surname</sql>
        <sql>ALTER TABLE clients ADD CONSTRAINT unique_name_surname_user UNIQUE (name, surname, user_id)</sql>
    </changeSet>

